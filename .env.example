# =============================================================================
# Chép thành .env rồi sửa. KHÔNG commit .env.
#
# Mọi giá trị dưới đây chỉ dùng cho MÁY LẬP TRÌNH: chúng nằm trong repo công
# khai nên ai cũng đọc được. Trước khi lên môi trường thật phải đổi hết — API
# tự từ chối khởi động nếu thấy secret mặc định khi NODE_ENV=production.
# =============================================================================

# ---- Postgres ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=55432
DB_NAME=pt
DB_PASSWORD=local-dev-only

# Migration chạy bằng chủ sở hữu schema
DATABASE_URL=postgres://pt_migrator:local-dev-only@localhost:55432/pt

# API chạy bằng role BỊ RLS áp. Đổi hai dòng này là mất cách ly tenant.
DATABASE_URL_APP=postgres://app_rw:local-dev-only@localhost:55432/pt
DATABASE_URL_AUTH=postgres://app_auth:local-dev-only@localhost:55432/pt
DATABASE_URL_PLATFORM=postgres://app_platform:local-dev-only@localhost:55432/pt

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=local-dev-only

# ---- S3 / MinIO --------------------------------------------------------------
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=pt-private
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
S3_FORCE_PATH_STYLE=true

# ---- Auth --------------------------------------------------------------------
# Sinh bằng: openssl rand -base64 48
JWT_ACCESS_SECRET=doi-truoc-khi-len-that-access
JWT_REFRESH_SECRET=doi-truoc-khi-len-that-refresh
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Khoá mã hoá credential Zalo OA của từng tenant (envelope encryption).
# Sinh bằng: openssl rand -base64 32
TENANT_SECRET_KEY=doi-truoc-khi-len-that-32-byte-base64

# ---- App ---------------------------------------------------------------------
NODE_ENV=development
# Đăng nhập nhanh chỉ bằng số điện thoại (tab "Vào nhanh" ở /login) để thử vai
# HLV / hội viên. CHỈ máy lập trình, hoặc máy chủ staging có thêm APP_ENV=staging
# trong ~/gym/.env. Máy chủ thật có cờ mà thiếu APP_ENV=staging thì API từ chối
# khởi động. Bỏ dấu # để bật.
# DEV_LOGIN_BYPASS=1
API_PORT=4000
APP_BASE_DOMAIN=localhost:3000
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

# ---- Zalo OA (Phase 6) -------------------------------------------------------
# Credential của từng phòng nhập trên màn Cài đặt > Zalo OA, KHÔNG nằm ở đây.
# log  = không gọi Zalo thật: tin ghi ra log của worker, luồng kết nối OA dùng
#        mã giả. Mặc định khi NODE_ENV khác production.
# http = gọi Zalo thật. Mặc định khi NODE_ENV=production.
ZALO_DRIVER=log
# 1 = gửi ZNS ở chế độ phát triển của Zalo (chỉ tới quản trị viên OA, không
#     tốn hạn mức) — dùng khi chạy thử trên OA thật.
ZALO_ZNS_DEV_MODE=0
# Đường dẫn callback OAuth dựng từ WEB_ORIGIN: <WEB_ORIGIN>/settings/zalo/callback
WEB_ORIGIN=http://localhost:3000

# ---- SMS dự phòng cho OTP ------------------------------------------------------
# Dùng khi mã OTP không gửi được qua Zalo.
# log = ghi tin ra log của worker (mặc định khi NODE_ENV khác production;
#       config-guard CHẶN giá trị này ở production vì log chứa mã OTP).
# off = không gửi SMS (mặc định ở production cho tới khi có nhà cung cấp).
SMS_DRIVER=log

# ---- Thu tiền gói SaaS (Phase 7) ---------------------------------------------
# Tài khoản NHẬN TIỀN của nền tảng, hiện cho chủ phòng trên màn "Gói dịch vụ".
# Bỏ trống thì màn đó bảo chủ phòng liên hệ hỗ trợ thay vì hiện số tài khoản.
# Điền giá trị thật ở .env của máy chủ, không ở tệp mẫu này.
SAAS_BANK_NAME=
SAAS_BANK_ACCOUNT=
SAAS_BANK_HOLDER=
# Kênh hỗ trợ hiện cho chủ phòng (VD: "Zalo 09xx xxx xxx").
SAAS_SUPPORT_CONTACT=

# Webhook SePay (tuỳ chọn): tự khớp chuyển khoản với hoá đơn gói.
# Trên SePay: Tích hợp → Webhooks → URL <WEB_ORIGIN>/api/webhooks/sepay, xác thực
# "API Key", dán cùng một khoá vào đây. Bỏ trống = tắt, endpoint trả 404.
SEPAY_WEBHOOK_KEY=

# Sao lưu tự động (dịch vụ `backup`, chỉ máy chủ — deploy/README.md "Sao lưu").
# Chạy tay ở máy dev: BACKUP_S3=0 PG_BIN=<thư mục pg_dump 17> pnpm tsx db/backup.ts once
BACKUP_DIR=./backups
BACKUP_S3=0
# BACKUP_ENCRYPTION_KEY=   # openssl rand -hex 32 — bắt buộc khi BACKUP_S3=1
# BACKUP_ALERT_WEBHOOK=
# BACKUP_HEARTBEAT_URL=
